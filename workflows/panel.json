    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Panel – Bar El Algoritmo</title>\n<style>\n  /* Tamaños en vh/vw: en un proyector la imagen mide lo mismo en la pared\n     sea cual sea la resolución, así que el texto escala con la pantalla. */\n  :root {\n    --fondo: #f4efe6;\n    --lateral: #ebe2d3;\n    --tarjeta: #ffffff;\n    --tinta: #1b1b1b;\n    --suave: #474747;\n    --marca: #9c3412;\n    --queja: #c62828;       --queja-bg: #fde4e1;\n    --sugerencia: #a86a10;  --sugerencia-bg: #fdefc8;\n    --felicitacion: #2e7d32; --felicitacion-bg: #dcf2dd;\n    --pregunta: #1d5fbf;    --pregunta-bg: #dce8fb;\n    --comentario: #5f6368;  --comentario-bg: #ebebeb;\n    --neutro-bg: #f1ece4;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  html, body { height: 100%; overflow: hidden; }\n  body {\n    background: var(--fondo);\n    color: var(--tinta);\n    font-family: system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n    display: grid;\n    grid-template-columns: 26vw 1fr;\n    grid-template-rows: 100vh;\n  }\n\n  /* ---------- Lateral: nombre del bar, QR y estado ---------- */\n  .lateral {\n    background: var(--lateral);\n    border-right: .5vh solid var(--marca);\n    padding: 4vh 2.4vw;\n    display: flex;\n    flex-direction: column;\n    gap: 2.2vh;\n    min-width: 0;\n  }\n  .kicker {\n    font-size: 2.2vh;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    color: var(--marca);\n  }\n  h1 {\n    font-size: min(6vh, 3.9vw);\n    line-height: 1.02;\n    font-weight: 800;\n    letter-spacing: -.02em;\n  }\n  .ficticio { font-size: 2.2vh; color: var(--suave); }\n  .qr {\n    margin-top: auto;\n    width: min(32vh, 21vw);\n    aspect-ratio: 1;\n    background: #fff;\n    border-radius: 1.2vh;\n    padding: 1.4vh;\n    display: grid;\n    place-items: center;\n    box-shadow: 0 .3vh 1vh rgba(0, 0, 0, .08);\n  }\n  .qr svg, .qr img { width: 100%; height: 100%; display: block; }\n  .invitacion { font-size: 3vh; font-weight: 700; line-height: 1.15; }\n  .invitacion small { display: block; font-size: 2.2vh; font-weight: 400; color: var(--suave); margin-top: .6vh; }\n  .estado {\n    margin-top: auto;\n    display: flex;\n    align-items: center;\n    gap: 1vh;\n    font-size: 2vh;\n    font-weight: 600;\n    color: var(--suave);\n  }\n  .estado::before {\n    content: \"\";\n    width: 1.6vh;\n    height: 1.6vh;\n    border-radius: 50%;\n    background: #9e9e9e;\n  }\n  .estado.ok::before { background: #2e7d32; animation: latido 2s ease-in-out infinite; }\n  @keyframes latido { 50% { opacity: .35; } }\n\n  /* ---------- Lista de reseñas ---------- */\n  main { position: relative; height: 100vh; padding: 1.4vh 1.6vw; min-width: 0; }\n  /* Lista con scroll: caben unas 4 tarjetas a la vista y el resto se ve\n     bajando con la rueda o el touchpad. El degradado de abajo indica que hay más. */\n  #lista {\n    list-style: none;\n    height: 100%;\n    overflow-y: auto;\n    overflow-x: hidden;\n    display: flex;\n    flex-direction: column;\n    gap: 1.6vh;\n    padding: 1vh 1vw 8vh;\n    scrollbar-width: thin;\n    scrollbar-color: #c9b9a3 transparent;\n    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 7vh), transparent);\n    mask-image: linear-gradient(to bottom, #000 calc(100% - 7vh), transparent);\n  }\n  .card {\n    background: var(--tarjeta);\n    border-radius: 1.4vh;\n    border-left: 1.1vh solid var(--comentario);\n    padding: 1.5vh 2.2vw 1.5vh 1.8vw;\n    display: flex;\n    flex-direction: column;\n    gap: .7vh;\n    flex: none;\n    position: relative;\n    overflow: hidden;\n    box-shadow: 0 .3vh 1vh rgba(0, 0, 0, .08);\n    outline: .6vh solid transparent;\n    outline-offset: .2vh;\n  }\n  .card.cat-queja        { border-left-color: var(--queja); }\n  .card.cat-sugerencia   { border-left-color: var(--sugerencia); }\n  .card.cat-felicitacion { border-left-color: var(--felicitacion); }\n  .card.cat-pregunta     { border-left-color: var(--pregunta); }\n  .card.cat-comentario   { border-left-color: var(--comentario); }\n\n  .meta { display: flex; align-items: center; gap: .8vw; flex-wrap: nowrap; min-width: 0; }\n  .chip {\n    font-size: 2.2vh;\n    font-weight: 600;\n    padding: .45vh 1vw;\n    border-radius: 99vh;\n    background: var(--neutro-bg);\n    white-space: nowrap;\n  }\n  .cat-queja .chip.cat        { background: var(--queja-bg); }\n  .cat-sugerencia .chip.cat   { background: var(--sugerencia-bg); }\n  .cat-felicitacion .chip.cat { background: var(--felicitacion-bg); }\n  .cat-pregunta .chip.cat     { background: var(--pregunta-bg); }\n  .cat-comentario .chip.cat   { background: var(--comentario-bg); }\n  .hora { margin-left: auto; font-size: 2.2vh; font-weight: 600; color: var(--suave); font-variant-numeric: tabular-nums; }\n\n  .summary {\n    font-size: 3.5vh;\n    line-height: 1.15;\n    font-weight: 700;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    line-clamp: 2;\n    overflow: hidden;\n  }\n  .original {\n    font-size: 2.3vh;\n    line-height: 1.3;\n    color: var(--suave);\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n    line-clamp: 2;\n    overflow: hidden;\n    overflow-wrap: anywhere;\n  }\n\n  /* Queja con urgencia alta: la misma regla que dispara el aviso por Telegram */\n  .card.urgente {\n    background: #fff1ef;\n    box-shadow: 0 0 0 .35vh var(--queja), 0 .3vh 1vh rgba(0, 0, 0, .08);\n  }\n  .chip.aviso { background: var(--queja); color: #fff; }\n\n  /* Reseña recién llegada. La caída desde arriba, el empuje de las demás y la\n     sacudida de las urgentes los hace el script; aquí van el borde amarillo\n     con resplandor y un destello de luz que cruza la tarjeta. */\n  .card.nueva { animation: destello 3.4s ease-out; }\n  .card.nueva::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(105deg, transparent 35%, rgba(255, 210, 90, .6) 50%, transparent 65%);\n    transform: translateX(-110%);\n    animation: brillo 1.1s .5s ease-out forwards;\n    pointer-events: none;\n  }\n  @keyframes destello {\n    0%, 55% { outline-color: #f2a900; filter: drop-shadow(0 0 1.4vh rgba(242, 169, 0, .7)); }\n    100% { outline-color: transparent; filter: none; }\n  }\n  @keyframes brillo { to { transform: translateX(110%); } }\n\n  /* ---------- Estado vacío ---------- */\n  .vacio {\n    position: absolute;\n    inset: 0;\n    display: grid;\n    place-content: center;\n    text-align: center;\n    gap: 1.5vh;\n  }\n  .vacio[hidden] { display: none; }\n  .vacio .icono { font-size: 12vh; line-height: 1; }\n  .vacio .titulo { font-size: 5.5vh; font-weight: 800; }\n  .vacio .sub { font-size: 3vh; color: var(--suave); }\n</style>\n</head>\n<body>\n  <aside class=\"lateral\">\n    <p class=\"kicker\">Reseñas en directo</p>\n    <h1>Bar El Algoritmo</h1>\n    <p class=\"ficticio\">Bar de tapas ficticio · Granada</p>\n\n    <div class=\"qr\" id=\"qr\">\n      <svg role=\"img\" aria-label=\"Código QR del formulario de reseñas\" shape-rendering=\"crispEdges\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 41 41\" class=\"segno\"><path class=\"qrline\" stroke=\"#000\" d=\"M2 2.5h7m1 0h1m1 0h3m1 0h1m1 0h1m2 0h2m4 0h3m2 0h7m-37 1h1m5 0h1m2 0h3m1 0h1m1 0h1m1 0h3m3 0h4m1 0h1m1 0h1m5 0h1m-37 1h1m1 0h3m1 0h1m2 0h1m1 0h1m1 0h1m3 0h1m3 0h1m2 0h1m1 0h2m2 0h1m1 0h3m1 0h1m-37 1h1m1 0h3m1 0h1m1 0h4m1 0h1m1 0h1m2 0h1m1 0h1m3 0h3m1 0h1m1 0h1m1 0h3m1 0h1m-37 1h1m1 0h3m1 0h1m1 0h2m7 0h1m4 0h2m2 0h3m1 0h1m1 0h3m1 0h1m-37 1h1m5 0h1m1 0h2m1 0h2m1 0h2m1 0h1m1 0h1m8 0h1m1 0h1m5 0h1m-37 1h7m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h1m1 0h7m-29 1h1m1 0h2m2 0h2m3 0h3m1 0h2m1 0h1m1 0h1m-29 1h1m3 0h1m1 0h3m4 0h1m2 0h1m3 0h1m2 0h2m4 0h5m2 0h1m-36 1h2m2 0h1m2 0h1m2 0h1m2 0h1m2 0h3m2 0h1m1 0h1m2 0h2m3 0h2m1 0h1m-35 1h4m1 0h2m1 0h1m2 0h4m1 0h1m1 0h1m1 0h1m1 0h1m2 0h3m2 0h3m-34 1h1m14 0h7m1 0h1m4 0h1m5 0h2m-34 1h3m1 0h1m1 0h1m1 0h1m6 0h2m1 0h3m1 0h1m1 0h1m1 0h3m3 0h3m-36 1h1m2 0h2m1 0h1m1 0h2m1 0h1m2 0h2m1 0h1m2 0h1m1 0h6m3 0h2m-32 1h1m2 0h4m1 0h1m2 0h1m1 0h3m5 0h1m1 0h1m1 0h2m1 0h5m-35 1h1m1 0h1m10 0h3m1 0h2m1 0h1m1 0h3m3 0h1m1 0h3m1 0h2m-33 1h1m2 0h2m1 0h1m1 0h2m2 0h1m2 0h2m2 0h3m3 0h4m1 0h4m-36 1h1m2 0h2m1 0h1m8 0h2m1 0h3m2 0h1m1 0h3m3 0h4m-36 1h1m2 0h4m1 0h1m1 0h2m4 0h1m1 0h1m1 0h5m1 0h2m2 0h1m1 0h3m-33 1h1m2 0h1m1 0h1m5 0h1m3 0h1m3 0h1m1 0h1m2 0h1m2 0h4m1 0h2m-31 1h2m2 0h1m1 0h1m3 0h1m1 0h1m1 0h1m1 0h1m2 0h1m2 0h5m2 0h1m-35 1h1m1 0h2m7 0h1m1 0h5m5 0h1m1 0h4m2 0h2m-27 1h1m2 0h2m4 0h1m2 0h1m1 0h5m1 0h2m2 0h5m-33 1h3m5 0h1m2 0h1m2 0h1m2 0h1m1 0h1m1 0h1m2 0h2m3 0h2m1 0h1m-35 1h2m1 0h4m2 0h4m1 0h1m1 0h1m2 0h2m3 0h1m5 0h2m1 0h4m-37 1h2m1 0h2m3 0h3m1 0h2m4 0h2m1 0h3m1 0h1m1 0h2m2 0h2m-30 1h1m2 0h4m1 0h2m1 0h2m1 0h3m1 0h1m1 0h1m2 0h6m2 0h1m-32 1h3m4 0h2m1 0h1m1 0h3m1 0h3m2 0h1m1 0h1m4 0h1m2 0h1m-35 1h2m1 0h1m2 0h1m1 0h2m1 0h2m1 0h1m2 0h1m3 0h4m3 0h7m1 0h1m-29 1h9m4 0h1m1 0h1m1 0h1m2 0h1m3 0h1m2 0h1m-36 1h7m1 0h2m1 0h3m1 0h1m1 0h1m2 0h1m2 0h3m2 0h1m1 0h1m1 0h1m-33 1h1m5 0h1m2 0h2m3 0h5m3 0h3m1 0h1m1 0h1m3 0h3m1 0h1m-37 1h1m1 0h3m1 0h1m1 0h2m2 0h1m1 0h2m2 0h1m3 0h1m1 0h1m3 0h8m-36 1h1m1 0h3m1 0h1m2 0h1m1 0h1m4 0h1m2 0h3m1 0h1m1 0h2m1 0h4m4 0h1m-37 1h1m1 0h3m1 0h1m2 0h4m1 0h1m1 0h1m3 0h5m3 0h1m1 0h1m2 0h1m-34 1h1m5 0h1m2 0h1m2 0h2m3 0h1m3 0h4m1 0h2m2 0h1m1 0h1m1 0h2m-36 1h7m1 0h1m1 0h3m1 0h4m1 0h4m4 0h1m1 0h1m1 0h1m2 0h3\"/></svg>\n    </div>\n    <p class=\"invitacion\">Escanea y deja tu reseña<small>Con la cámara del móvil o con Google Lens. La IA la clasifica al momento.</small></p>\n\n    <p class=\"estado\" id=\"estado\">Conectando…</p>\n  </aside>\n\n  <main>\n    <ul id=\"lista\"></ul>\n    <div class=\"vacio\" id=\"vacio\" hidden>\n      <div class=\"icono\">🍤</div>\n      <p class=\"titulo\">Todavía no hay reseñas</p>\n      <p class=\"sub\">¡Escanea el QR y sé el primero!</p>\n    </div>\n  </main>\n\n<script>\n  /* Sin comentarios de doble barra en este script: si el campo Fixed de n8n\n     juntara las líneas, comentarían todo lo que va detrás. */\n  const URL_DATOS = '/webhook/panel-datos';\n  const MAX_TARJETAS = 20;   /* lo mismo que devuelve panel-datos (Limit 20) */\n  const REFRESCO_MS = 3000;\n\n  /* Mismos textos y emojis que el node \"Etiquetas\" del formulario.\n     inapropiado y sin_clasificar no están: la página tampoco los pinta. */\n  const CATEGORIAS = {\n    queja: '😠 Queja',\n    sugerencia: '💡 Sugerencia',\n    felicitacion: '🎉 Felicitación',\n    pregunta: '❓ Pregunta',\n    comentario: '💬 Comentario'\n  };\n  const SENTIMIENTOS = { positivo: '🙂 Positivo', neutro: '😐 Neutro', negativo: '🙁 Negativo' };\n  const URGENCIAS = { alta: '🔴 Urgencia alta', media: '🟠 Urgencia media', baja: '🟢 Urgencia baja' };\n\n  const lista = document.getElementById('lista');\n  const vacio = document.getElementById('vacio');\n  const estado = document.getElementById('estado');\n\n  /* Las tarjetas ya pintadas se reutilizan (no se borra la lista en cada\n     refresco): así se puede animar cómo se desplazan cuando llega una nueva. */\n  const tarjetas = new Map();  /* id de la reseña -> su <li> */\n  let primeraCarga = true;     /* en la primera carga no se anima nada */\n  let ultimoCuerpo = null;     /* si la respuesta no cambia, no se toca nada */\n\n  function esperar(ms) {\n    return new Promise(function (ok) { setTimeout(ok, ms); });\n  }\n\n  function firma(r) {\n    return [r.category, r.sentiment, r.urgency, r.summary, r.text, r.createdAt].join('|');\n  }\n\n  function el(tag, clase, texto) {\n    const e = document.createElement(tag);\n    if (clase) e.className = clase;\n    if (texto !== undefined) e.textContent = texto;\n    return e;\n  }\n\n  function hora(iso) {\n    const d = new Date(iso);\n    return isNaN(d) ? '' : d.toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });\n  }\n\n  function tarjeta(r) {\n    const urgente = r.category === 'queja' && r.urgency === 'alta';\n    const li = el('li', 'card cat-' + r.category);\n    li.dataset.firma = firma(r);\n    if (urgente) li.classList.add('urgente');\n\n    const meta = el('div', 'meta');\n    if (urgente) meta.append(el('span', 'chip aviso', '🚨 Aviso al encargado'));\n    meta.append(el('span', 'chip cat', CATEGORIAS[r.category]));\n    if (SENTIMIENTOS[r.sentiment]) meta.append(el('span', 'chip', SENTIMIENTOS[r.sentiment]));\n    if (URGENCIAS[r.urgency] && !urgente) meta.append(el('span', 'chip', URGENCIAS[r.urgency]));\n    meta.append(el('span', 'hora', hora(r.createdAt)));\n\n    li.append(meta);\n    li.append(el('p', 'summary', r.summary || ''));\n    li.append(el('p', 'original', '“' + (r.text || '') + '”'));\n    return li;\n  }\n\n  /* Entrada de una reseña nueva: cae desde arriba con un pequeño rebote,\n     se ilumina en amarillo y, si es una queja urgente, se sacude. */\n  function animarEntrada(li, retraso) {\n    li.style.opacity = '0';\n    setTimeout(function () {\n      li.style.opacity = '';\n      li.classList.add('nueva');\n      const entrada = li.animate([\n        { opacity: 0, transform: 'translateY(-70%) scale(.9)' },\n        { opacity: 1, transform: 'translateY(1.5vh) scale(1.015)', offset: .65 },\n        { opacity: 1, transform: 'none' }\n      ], { duration: 900, easing: 'cubic-bezier(.2, .8, .2, 1)' });\n      if (li.classList.contains('urgente')) {\n        entrada.finished.then(function () {\n          li.animate([\n            { transform: 'none' },\n            { transform: 'translateX(-.9vw) rotate(-.5deg)' },\n            { transform: 'translateX(.9vw) rotate(.5deg)' },\n            { transform: 'translateX(-.6vw) rotate(-.3deg)' },\n            { transform: 'translateX(.6vw) rotate(.3deg)' },\n            { transform: 'none' }\n          ], { duration: 650, easing: 'ease-in-out' });\n        }, function () {});\n      }\n      setTimeout(function () { li.classList.remove('nueva'); }, 3800);\n    }, retraso);\n  }\n\n  async function pintar(rows) {\n    /* Segunda barrera: aunque el filtro está en n8n, solo se pintan\n       categorías conocidas y nunca filas ocultas. */\n    const visibles = rows.filter(function (r) {\n      return r && CATEGORIAS[r.category] && r.hidden !== true;\n    }).slice(0, MAX_TARJETAS);\n    const ids = new Set(visibles.map(function (r) { return r.id; }));\n    const nuevos = primeraCarga ? [] : visibles.filter(function (r) { return !tarjetas.has(r.id); });\n\n    /* Si alguien ha bajado por la lista, primero vuelve arriba para que se vea la nueva */\n    if (nuevos.length && lista.scrollTop > 2) {\n      lista.scrollTo({ top: 0, behavior: 'smooth' });\n      await esperar(600);\n    }\n\n    /* Técnica FLIP: se apunta dónde está cada tarjeta antes del cambio... */\n    const antes = new Map();\n    tarjetas.forEach(function (li, id) { antes.set(id, li.getBoundingClientRect().top); });\n\n    const sobran = [];\n    tarjetas.forEach(function (li, id) { if (!ids.has(id)) sobran.push(id); });\n    sobran.forEach(function (id) { tarjetas.get(id).remove(); tarjetas.delete(id); });\n\n    let anterior = null;\n    for (const r of visibles) {\n      let li = tarjetas.get(r.id);\n      if (li && li.dataset.firma !== firma(r)) {\n        const nuevo = tarjeta(r);\n        li.replaceWith(nuevo);\n        li = nuevo;\n        tarjetas.set(r.id, li);\n      }\n      if (!li) {\n        li = tarjeta(r);\n        tarjetas.set(r.id, li);\n      }\n      const sitio = anterior ? anterior.nextSibling : lista.firstChild;\n      if (li !== sitio) lista.insertBefore(li, sitio);\n      anterior = li;\n    }\n\n    /* ...y cada una se dibuja donde estaba y se desliza a su sitio nuevo:\n       es el efecto de que la reseña nueva empuja a las demás. */\n    tarjetas.forEach(function (li, id) {\n      if (!antes.has(id)) return;\n      const dy = antes.get(id) - li.getBoundingClientRect().top;\n      if (Math.abs(dy) > 1) {\n        li.animate([\n          { transform: 'translateY(' + dy + 'px)' },\n          { transform: 'none' }\n        ], { duration: 800, easing: 'cubic-bezier(.22, 1, .36, 1)' });\n      }\n    });\n\n    nuevos.forEach(function (r, i) { animarEntrada(tarjetas.get(r.id), i * 180); });\n\n    vacio.hidden = visibles.length > 0;\n    primeraCarga = false;\n  }\n\n  function enDirecto(ok) {\n    estado.classList.toggle('ok', ok);\n    estado.textContent = ok ? 'En directo' : 'Reconectando…';\n  }\n\n  async function cargar() {\n    try {\n      const res = await fetch(URL_DATOS, { cache: 'no-store' });\n      if (!res.ok) throw new Error('HTTP ' + res.status);\n      const cuerpo = await res.text();\n      if (cuerpo !== ultimoCuerpo) {\n        const data = cuerpo ? JSON.parse(cuerpo) : [];\n        const rows = Array.isArray(data) ? data : (data && data.id !== undefined ? [data] : []);\n        await pintar(rows);\n        ultimoCuerpo = cuerpo;\n      }\n      enDirecto(true);\n    } catch (e) {\n      enDirecto(false);\n    }\n    setTimeout(cargar, REFRESCO_MS);\n  }\n\n  cargar();\n</script>\n</body>\n</html>",
